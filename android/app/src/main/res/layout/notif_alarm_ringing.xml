<?xml version="1.0" encoding="utf-8"?>
<!--
  Slim alarm notification: compact single row — time + info on the left,
  round blue Stop button on the right. Styled like the system clock app's
  "Upcoming alarm" notification (v2.17: slimmed per user feedback).
  Used via RemoteViews from AlarmService while the alarm is ringing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="#23272E">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:40"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:id="@+id/notif_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alarm"
            android:textSize="12sp"
            android:textColor="#B0B7C3"
            android:maxLines="1"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>

    <Button
        android:id="@+id/notif_stop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:text="Stop"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:singleLine="true"
        android:background="@drawable/notif_stop_circle" />
</LinearLayout>
