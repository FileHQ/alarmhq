<?xml version="1.0" encoding="utf-8"?>
<!--
  Xiaomi-style slim alarm notification: compact time on the left, info line
  below it, and a round blue Stop button on the right.
  Used via RemoteViews from AlarmService while the alarm is ringing.
  v2.14: slim/compact — reduced time size and padding per user feedback.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="#23272E">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:40"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:id="@+id/notif_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Alarm"
            android:textSize="13sp"
            android:textColor="#B0B7C3"
            android:maxLines="1"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>

    <Button
        android:id="@+id/notif_stop"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:text="Stop"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:singleLine="true"
        android:background="@drawable/notif_stop_circle" />
</LinearLayout>
