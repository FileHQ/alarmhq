<?xml version="1.0" encoding="utf-8"?>
<!--
  Xiaomi-style alarm notification: big time on the left, info line
  below it, and a round blue Stop button on the right.
  Used via RemoteViews from AlarmService while the alarm is ringing.
  v2.11: fixed cramped layout — text sizes tuned, info line single-line
  with ellipsize, proper margins so nothing is cut off.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="#23272E">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:40"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1" />

        <TextView
            android:id="@+id/notif_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Alarm"
            android:textSize="14sp"
            android:textColor="#B0B7C3"
            android:maxLines="1"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>

    <Button
        android:id="@+id/notif_stop"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginStart="12dp"
        android:text="Stop"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:background="@drawable/notif_stop_circle" />
</LinearLayout>
